{
  "name": "nextjs-migration",
  "version": "1.0.0",
  "description": "국세기본법·국세징수법·법인세법·소득세법·부가가치세법에서 10개씩 고른 50개 쟁점을 읽는 별도 정적 사이트입니다. 각 쟁점은 `사실관계 전문 → 핵심 질문 → 질문별 판단(관련 조문·답·해설·증빙)` 순서로 읽은 뒤 `판례·조사·회계 연결 → 조건이 달라지면 → 마지막 정리`로 마칩니다.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:node",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:node": "npm run build && node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify": "npm run typecheck && npm run test:node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true
}
